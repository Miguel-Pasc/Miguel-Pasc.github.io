---
const {source, alternative, title, description, fecha} = Astro.props;
---

<div
    class="bg-white border-gray-200 dark:border-0 border-2 rounded-xl shadow-md overflow-hidden transition-transform duration-300 hover:-translate-y-1 font-sans text-gray-900 dark:bg-gray-600/50 dark:text-gray-50 p-4 flex mb-[30px]"
    >
    <div class="p-[30px] w-[40%]">
        <img 
        src={source}
        alt={alternative} 
        class="h-[500px]" />
    </div>
    <div class="p-[30px] flex flex-col w-[60%]">
        <div class="h-[95%]">
            <h3 class="text-blue-700 dark:text-blue-200 text-xl font-semibold text-center mt-3">{title}</h3>
            <p class="text-justify text-gray-700 dark:text-gray-50 px-3 pb-8 pt-3">
                {description}
            </p>
        </div>        
        <div class="h-5% flex justify-end items-end">
            <p class=" text-gray-700/50 dark:text-gray-50/50 px-3 italic">
                {fecha}
            </p>
        </div>
    </div>
</div>